{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cuplock",
  "version": "3.0.0",
  "identifier": "com.cuplock.app",
  "build": {
    "frontendDist": "../../client"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cuplock",
        "width": 1200,
        "height": 780,
        "minWidth": 820,
        "minHeight": 560,
        "center": true,
        "backgroundColor": "#111216",
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Cuplock",
    "shortDescription": "App de mensagens",
    "category": "SocialNetworking",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ]
      }
    }
  }
}